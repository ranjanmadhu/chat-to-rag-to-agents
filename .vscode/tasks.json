{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start dev stack",
      "type": "shell",
      "command": "node scripts/start-dev-stack.mjs",
      "isBackground": true,
      "problemMatcher": {
        "owner": "dev-stack",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting|already running",
          "endsPattern": "Development stack is running."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Stop dev stack",
      "type": "shell",
      "command": "node scripts/stop-dev-stack.mjs",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Deploy Azure (dev-demo)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-File",
        "scripts/azure/deploy.ps1",
        "-EnvironmentName",
        "dev",
        "-Location",
        "westeurope"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Teardown Azure (dev-demo)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-File",
        "scripts/azure/teardown.ps1",
        "-ResourceGroupName",
        "rg-chatbot-dev",
        "-Force"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
